# Local Vite proxy target for NAV, price, and futarchy data. Production uses
# NAVGATOR_API_ORIGIN through the same-origin serverless relay.
VITE_NAVGATOR_API_BASE=https://navgator.xyz

# Server-only upstream for the data routes that remain owned by NAVgator.
NAVGATOR_API_ORIGIN=https://api.navgator.xyz

# Server-only guarded ownership trading configuration. Set both variables in
# Vercel Production and Preview. Never expose them as VITE_* variables.
DFLOW_API_KEY=
SOLANA_RPC_URL=

# Server-only 01RX decision-volume attribution authority. Generate one stable
# keypair with `npm run generate:attribution-key`, then store both values in
# Vercel Production and Preview. The private key must never use a VITE_* name.
O1RX_ATTRIBUTION_PUBLIC_KEY=
O1RX_ATTRIBUTION_SIGNING_KEY=

# Optional. Vercel Production and Preview default to
# https://quote-api.dflow.net; local development defaults to
# https://dev-quote-api.dflow.net. Only those two origins are accepted.
DFLOW_TRADE_API_URL=

# Optional approved private TradingView Advanced Charts library origin/path.
# Never commit the proprietary library itself.
VITE_TRADINGVIEW_LIBRARY_PATH=
