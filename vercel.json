{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "base-uri 'self'; object-src 'none'"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), microphone=()"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/terminal",
      "destination": "/?token=solo&view=markets&tab=tokens",
      "permanent": false
    },
    {
      "source": "/widgets/chart/:path*",
      "destination": "/?token=solo&view=markets&tab=tokens",
      "permanent": false
    },
    {
      "source": "/navgator-for-agents/:path*",
      "destination": "/?token=solo&view=markets&tab=tokens",
      "permanent": false
    },
    {
      "source": "/guide.html",
      "destination": "/?token=solo&view=markets&tab=tokens",
      "permanent": false
    },
    {
      "source": "/methodology.html",
      "destination": "/?token=solo&view=markets&tab=tokens",
      "permanent": false
    },
    {
      "source": "/llms.txt",
      "destination": "/?token=solo&view=markets&tab=tokens",
      "permanent": false
    },
    {
      "source": "/llms-full.txt",
      "destination": "/?token=solo&view=markets&tab=tokens",
      "permanent": false
    },
    {
      "source": "/projects/:path*",
      "destination": "/?token=solo&view=markets&tab=tokens",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:relayPath*",
      "destination": "/api/relay?relayPath=:relayPath"
    },
    {
      "source": "/embed",
      "destination": "/index.html"
    }
  ]
}
