{
  "framework": "vite",
  "redirects": [
    {
      "source": "/terminal",
      "destination": "/?token=solo&view=markets&tab=tokens",
      "permanent": false
    },
    {
      "source": "/navgator-for-agents/:path*",
      "destination": "/?token=solo&view=markets&tab=tokens",
      "permanent": false
    },
    {
      "source": "/guide.html",
      "destination": "/?token=solo&view=markets&tab=tokens",
      "permanent": false
    },
    {
      "source": "/methodology.html",
      "destination": "/?token=solo&view=markets&tab=tokens",
      "permanent": false
    },
    {
      "source": "/llms.txt",
      "destination": "/?token=solo&view=markets&tab=tokens",
      "permanent": false
    },
    {
      "source": "/llms-full.txt",
      "destination": "/?token=solo&view=markets&tab=tokens",
      "permanent": false
    },
    {
      "source": "/projects/:path*",
      "destination": "/?token=solo&view=markets&tab=tokens",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/embed",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ]
}
